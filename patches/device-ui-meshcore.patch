+        if (!lv_obj_check_type(icon, &lv_image_class))
+            continue;
+        const void *src = lv_obj_get_style_bg_image_src(button, LV_PART_MAIN);
+        if (src && lv_image_get_src(icon) != src)
+            lv_image_set_src(icon, src);
+        lv_obj_set_style_image_recolor(icon, lv_obj_get_style_bg_image_recolor(button, LV_PART_MAIN), ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
