+// The small line above a message bubble: who and when, and for our own messages what became of them
+static lv_obj_t *makeMessageMeta(lv_obj_t *row, lv_obj_t *bubble, const char *text, bool right)
+{
+    lv_obj_t *meta = lv_label_create(row);
