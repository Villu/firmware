+/**
+ * The small indicators left of the battery, on every screen. Top row: satellites in view and GPS, Wi-Fi, Bluetooth.
+ * Bottom row: MeshCore, MQTT, SD card. White (MeshCore orange, a connected phone blue) when up, dim when switched on
+ * but not connected or without a fix, absent when switched off.
+ */
+void TFTView_320x240::updateTopStatus(void)
+{
+    static lv_obj_t *label = nullptr;
+    if (!label) {
+        if (!objects.battery_panel)
+            return;
+        label = lv_label_create(lv_obj_get_parent(objects.battery_panel));
+        lv_label_set_recolor(label, true);
+        lv_obj_set_size(label, LV_SIZE_CONTENT, LV_SIZE_CONTENT);
+        lv_obj_remove_flag(label, LV_OBJ_FLAG_CLICKABLE);
+        lv_obj_set_style_text_font(label, &lv_font_montserrat_10, ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+        lv_obj_set_style_text_color(label, lv_color_hex(0xffffff), ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+        lv_obj_set_style_text_align(label, LV_TEXT_ALIGN_RIGHT, ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+        lv_obj_set_style_text_line_space(label, 0, ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+        lv_obj_move_foreground(label); // once: lists and dialogs opened later go above it
+    }
+#define TOP_ON "#ffffff "
+#define TOP_DIM "#86a3a5 "
+    char buf[200];
+    int n = 0;
+    const meshtastic_DeviceConnectionStatus &status = db.connectionStatus;
+
+    uint32_t sats = ownSats;
+    bool fix = ownSats > 0;
+    if (firmwareGpsStatus)
+        fix = firmwareGpsStatus(&sats);
+    if (sats || db.config.position.gps_mode == meshtastic_Config_PositionConfig_GpsMode_ENABLED)
+        n += lv_snprintf(buf + n, sizeof(buf) - n, "%s%u " LV_SYMBOL_GPS "# ", fix ? TOP_ON : TOP_DIM, (unsigned)sats);
+    if (db.config.network.wifi_enabled) {
+        const bool up = status.has_wifi && status.wifi.has_status && status.wifi.status.is_connected;
+        n += lv_snprintf(buf + n, sizeof(buf) - n, "%s" LV_SYMBOL_WIFI "# ", up ? TOP_ON : TOP_DIM);
+    }
+    if (db.config.bluetooth.enabled) {
+        const bool up = status.has_bluetooth && status.bluetooth.is_connected;
+        n += lv_snprintf(buf + n, sizeof(buf) - n, "%s" LV_SYMBOL_BLUETOOTH "#", up ? "#7fc4ff " : TOP_DIM);
+    }
+    n += lv_snprintf(buf + n, sizeof(buf) - n, "\n");
+    if (unreadMessages)
+        n += lv_snprintf(buf + n, sizeof(buf) - n, "#ff8c04 %u " LV_SYMBOL_ENVELOPE "# ", (unsigned)unreadMessages);
+    if (meshcoreUiStatus)
+        n += lv_snprintf(buf + n, sizeof(buf) - n, "%sMC# ", meshcoreUiStatus(nullptr, nullptr, 0) ? "#ff8c04 " : TOP_DIM);
+    if (db.module_config.mqtt.enabled) {
+        const bool up = status.has_wifi && status.wifi.has_status && status.wifi.status.is_mqtt_connected;
+        n += lv_snprintf(buf + n, sizeof(buf) - n, "%s" LV_SYMBOL_UPLOAD "# ", up ? TOP_ON : TOP_DIM);
+    }
+    if (cardDetected)
+        n += lv_snprintf(buf + n, sizeof(buf) - n, TOP_ON LV_SYMBOL_SD_CARD "#");
+#undef TOP_ON
+#undef TOP_DIM
+    lv_label_set_text(label, buf);
+
+    // right of it: the battery symbol, and the charge in percent when there is one
+    const char *percent = lv_label_get_text(objects.battery_percentage_label);
+    const int32_t percentWidth =
+        percent && percent[0] > ' ' ? lv_text_get_width(percent, strlen(percent), &ui_font_montserrat_12, 0) + 4 : 0;
+    lv_obj_align(label, LV_ALIGN_TOP_RIGHT, -(27 + percentWidth), 1);
+
+    // not over the QR code while that is up
+    const bool codeShown = objects.home_show_qr_panel && !lv_obj_has_flag(objects.home_show_qr_panel, LV_OBJ_FLAG_HIDDEN);
+    lv_obj_set_flag(label, LV_OBJ_FLAG_HIDDEN, codeShown);
+    lv_obj_set_flag(objects.battery_panel, LV_OBJ_FLAG_HIDDEN, codeShown);
 }
 
