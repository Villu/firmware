+// The home screen's pictures are button backgrounds, which cannot be drawn smaller. Each button gets a small copy of
+// its picture as a child and hides its own; a timer keeps picture and colour of the copy in step with the button.
+static void syncHomeIcons(lv_timer_t *)
+{
+    if (!objects.home_container)
+        return;
+    for (uint32_t i = 0; i < lv_obj_get_child_count(objects.home_container); i++) {
+        lv_obj_t *button = lv_obj_get_child(objects.home_container, i);
+        if (!lv_obj_check_type(button, &lv_button_class) || lv_obj_get_child_count(button) == 0)
+            continue;
+        lv_obj_t *icon = lv_obj_get_child(button, lv_obj_get_child_count(button) - 1);
+        if (!lv_obj_check_type(icon, &lv_image_class))
+            continue;
+        const void *src = lv_obj_get_style_bg_image_src(button, LV_PART_MAIN);
+        if (src && lv_image_get_src(icon) != src)
+            lv_image_set_src(icon, src);
+        // only when it changed: setting a style redraws the picture, and this runs twice a second
+        const lv_color_t color = lv_obj_get_style_bg_image_recolor(button, LV_PART_MAIN);
+        const lv_opa_t opa = lv_obj_get_style_bg_image_recolor_opa(button, LV_PART_MAIN);
+        if (!lv_color_eq(lv_obj_get_style_image_recolor(icon, LV_PART_MAIN), color) ||
+            lv_obj_get_style_image_recolor_opa(icon, LV_PART_MAIN) != opa) {
+            lv_obj_set_style_image_recolor(icon, color, ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+            lv_obj_set_style_image_recolor_opa(icon, opa, ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+        }
+    }
+}
