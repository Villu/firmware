+// MeshCore nodes carry " [MC]" at the end of their name (the firmware's MeshCoreModule): show the tag for those
+static bool isMeshCoreName(const char *longName)
+{
+    const size_t len = longName ? strlen(longName) : 0;
+    return len >= 5 && strcmp(longName + len - 5, " [MC]") == 0;
