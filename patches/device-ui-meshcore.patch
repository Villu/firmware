+// An opened node row, from the top: the two lines of the closed row, the node's number and role, then only what
+// there is: position (left) and telemetry (right), the line about a request, and the buttons that apply, three to a
+// line. Returns the height the row needs.
+static int32_t layoutOpenRow(lv_obj_t *row)
+{
+    if (row == objects.node_panel || lv_obj_get_child_count(row) <= node_stats_idx)
+        return ownRowOpen;
+    lv_obj_t **c = row->spec_attr->children;
+    int32_t y = 50; // one column of small lines under the number and role
+    const int lines[] = {lv_obj_get_child_count(row) > node_dev_idx ? (int)node_dev_idx : -1, node_tm1_idx, node_tm2_idx,
+                         node_pos1_idx, node_pos2_idx};
+    for (int i : lines) {
+        if (i < 0)
+            continue;
+        if (!lv_obj_has_flag(c[i], LV_OBJ_FLAG_HIDDEN) && lv_label_get_text(c[i])[0]) {
+            lv_obj_set_pos(c[i], -5, y);
+            lv_obj_update_layout(c[i]); // the telemetry lines wrap: a long one takes two lines
+            int32_t h = lv_obj_get_height(c[i]) + 1;
+            y += h < 13 ? 13 : h;
+        }
+    }
+    if (lv_label_get_text(c[node_status_idx])[0]) {
+        lv_obj_set_pos(c[node_status_idx], -5, y);
+        y += 13;
+    }
+    y += 3;
+    int placed = 0;
+    for (int i : {(int)node_msg_idx, (int)node_map_idx, (int)node_trace_idx, (int)node_info_idx, (int)node_askpos_idx,
+                  (int)node_askmet_idx, (int)node_askenv_idx, (int)node_qr_idx, (int)node_stats_idx}) {
+        if (lv_obj_has_flag(c[i], LV_OBJ_FLAG_HIDDEN))
+            continue;
+        lv_obj_set_pos(c[i], -2 + (placed % 3) * 83, y + (placed / 3) * 23);
+        placed++;
+    }
+    return y + ((placed + 2) / 3) * 23 + 4;
+}
+
+// While a row is open and something in it appears or goes: fit it again
+static void refreshOpenRow(lv_obj_t *row)
+{
+    if (row && lv_obj_get_height(row) > 60)
+        lv_obj_set_height(row, layoutOpenRow(row));
+}
