+        lv_obj_update_layout(objects.keyboard_button_0);
+        lv_obj_set_size(sendOverlay, lv_obj_get_width(objects.keyboard_button_0), lv_obj_get_height(objects.keyboard_button_0));
+        lv_obj_center(sendOverlay);
+        lv_obj_remove_flag(sendOverlay, LV_OBJ_FLAG_CLICKABLE);
+        lv_obj_set_style_text_font(sendOverlay, &lv_font_montserrat_16, ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+        lv_obj_set_style_text_align(sendOverlay, LV_TEXT_ALIGN_CENTER, ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+        lv_obj_set_style_pad_top(sendOverlay, 3, ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+        lv_obj_set_style_text_color(sendOverlay, lv_color_hex(0x000000), ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+        lv_obj_set_style_bg_color(sendOverlay, lv_color_hex(0x67ea94), ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+        lv_obj_set_style_bg_opa(sendOverlay, 255, ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+        lv_obj_set_style_radius(sendOverlay, 6, ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+    }
+    const char *text = lv_textarea_get_text(objects.message_input_area);
+    const uint32_t used = text ? strlen(text) : 0;
+    uint32_t most = lv_textarea_get_max_length(objects.message_input_area);
+    if (!most)
+        most = 200;
+    lv_obj_set_flag(sendOverlay, LV_OBJ_FLAG_HIDDEN, used == 0);
+    if (!used) {
+        lv_label_set_text(messageCounter, "");
+        return;
+    }
+    // which network this chat is on
+    bool meshcore = false;
+    if (activeMsgContainer) {
+        const uint32_t channelOrNode = (unsigned long)activeMsgContainer->user_data;
+        if (channelOrNode < c_max_channels)
+            meshcore = strcmp(db.channel[channelOrNode].settings.name, "MeshCore") == 0;
+        else if (nodes.find(channelOrNode) != nodes.end() && nodes[channelOrNode])
+            meshcore = isMeshCoreName(lv_label_get_text(nodes[channelOrNode]->LV_OBJ_IDX(node_lbl_idx)));
+    }
+    const uint32_t air = firmwareTextAirtimeMs ? firmwareTextAirtimeMs(used, meshcore) : 0;
+    if (air)
+        lv_label_set_text_fmt(messageCounter, "%u/%u  %u.%u s", (unsigned)used, (unsigned)most, (unsigned)(air / 1000),
+                              (unsigned)(air % 1000 / 100));
+    else
+        lv_label_set_text_fmt(messageCounter, "%u/%u", (unsigned)used, (unsigned)most);
+}
