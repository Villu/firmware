+        else if (nodes.find(channelOrNode) != nodes.end() && nodes[channelOrNode])
+            meshcore = isMeshCoreName(lv_label_get_text(nodes[channelOrNode]->LV_OBJ_IDX(node_lbl_idx)));
+    }
+    const uint32_t air = firmwareTextAirtimeMs ? firmwareTextAirtimeMs(used, meshcore) : 0;
+    if (air)
+        lv_label_set_text_fmt(messageCounter, "%u/%u  %u.%u s", (unsigned)used, (unsigned)most, (unsigned)(air / 1000),
+                              (unsigned)(air % 1000 / 100));
+    else
+        lv_label_set_text_fmt(messageCounter, "%u/%u", (unsigned)used, (unsigned)most);
+}
