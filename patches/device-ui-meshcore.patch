+// A frequency slot's frequency. The formula here is off for the narrow EU plan; the firmware knows the frequency of the
+// slot in use, so within the same region and preset the others are counted from that.
+static float slotFrequency(const meshtastic_Config_LoRaConfig &cfg, meshtastic_Config_LoRaConfig_ModemPreset preset,
+                           uint32_t channel)
+{
+    float frequency = LoRaPresets::getRadioFreq(cfg.region, preset, channel);
+    if (meshcoreUiStatus && cfg.use_preset && preset == cfg.modem_preset) {
+        float real = 0;
+        meshcoreUiStatus(&real, nullptr, 0);
+        if (real > 0)
+            frequency += real - LoRaPresets::getRadioFreq(cfg.region, cfg.modem_preset, cfg.channel_num);
+    }
+    return frequency;
+}
