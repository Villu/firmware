+// A frequency slot's frequency. The formula here is off for the narrow EU plan; the firmware knows the frequency of the
+// slot in use, so within the same region and preset the others are counted from that.
+static float slotFrequency(const meshtastic_Config_LoRaConfig &cfg, meshtastic_Config_LoRaConfig_ModemPreset preset,
+                           uint32_t channel)
+{
+    float frequency = LoRaPresets::getRadioFreq(cfg.region, preset, channel);
+    if (meshcoreUiStatus && cfg.use_preset && preset == cfg.modem_preset) {
+        float real = 0;
+        meshcoreUiStatus(&real, nullptr, 0);
+        if (real > 0)
+            frequency += real - LoRaPresets::getRadioFreq(cfg.region, cfg.modem_preset, cfg.channel_num);
+    }
+    return frequency;
+}
+
+// The word after the time of a message we sent
+static const char *sentStatusWord(LogMessage::MsgStatus status, bool toChannel)
+{
+    switch (status) {
+    case LogMessage::eNone:
+        return "sending";
+    case LogMessage::eHeard:
+        return "sent";
+    case LogMessage::eAcked:
+        return toChannel ? "sent" : "delivered";
+    case LogMessage::eNoResponse:
+        return "no reply";
+    case LogMessage::eFailed:
+        return "failed";
+    default:
+        return "";
+    }
+}
+
+// What became of a message we sent, on its row: the bubble's border, and the word after the time on the small line
+// ("<date time>  <status>"). The bubble remembers the status, so a repeat changes nothing; true if it changed.
+static bool applySentStatus(lv_obj_t *row, LogMessage::MsgStatus status, bool toChannel)
+{
+    if (!row || lv_obj_get_child_count(row) < 2)
+        return false;
+    lv_obj_t *bubble = lv_obj_get_child(row, 0);
+    lv_obj_t *metaLabel = lv_obj_get_child(row, 1);
+    if ((unsigned long)bubble->user_data == (unsigned long)status)
+        return false;
+    bubble->user_data = (void *)(unsigned long)status;
+    const bool failed = status == LogMessage::eFailed, acked = status == LogMessage::eAcked;
+    lv_obj_set_style_border_color(bubble, failed ? colorRed : acked ? colorBlueGreen : colorYellow,
+                                  ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+    char meta[48];
+    lv_snprintf(meta, sizeof(meta), "%s", lv_label_get_text(metaLabel));
+    char *sep = strstr(meta, "  ");
+    char *at = sep ? sep + 2 : (meta[0] >= '0' && meta[0] <= '9') ? meta + strlen(meta) : meta;
+    if (!sep && at != meta && sizeof(meta) - (at - meta) > 3) {
+        strcpy(at, "  ");
+        at += 2;
+    }
+    lv_snprintf(at, sizeof(meta) - (at - meta), "%s", sentStatusWord(status, toChannel));
+    lv_label_set_text(metaLabel, meta);
+    lv_obj_set_style_text_color(metaLabel,
+                                failed ? colorRed : acked && !toChannel ? colorMesh : lv_color_hex(0xa0a0a0),
+                                ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+    return true;
+}
+
+// The small line above a message bubble: who and when, and for our own messages what became of them
+static lv_obj_t *makeMessageMeta(lv_obj_t *row, lv_obj_t *bubble, const char *text, bool right)
+{
+    lv_obj_t *meta = lv_label_create(row);
+    lv_obj_set_size(meta, LV_SIZE_CONTENT, LV_SIZE_CONTENT);
+    lv_obj_set_align(meta, right ? LV_ALIGN_TOP_RIGHT : LV_ALIGN_TOP_LEFT);
+    lv_obj_set_pos(meta, right ? -4 : 4, 0);
+    lv_label_set_text(meta, text);
+    lv_obj_set_style_text_font(meta, &lv_font_montserrat_10, ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+    lv_obj_set_style_text_color(meta, lv_color_hex(0xa0a0a0), ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+    lv_obj_set_align(bubble, right ? LV_ALIGN_TOP_RIGHT : LV_ALIGN_TOP_LEFT);
+    lv_obj_set_y(bubble, 12);
+    return meta;
+}
 
