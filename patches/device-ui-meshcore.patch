+/**
+ * A button in the opened row of a node. Trace route, statistics and the contact code open their pages; the others
+ * send the node a request over the air (as far as it is away plus one hop) and say so on the row's status line.
+ */
+void TFTView_320x240::ui_event_NodeActionButton(lv_event_t *e)
+{
+    const int action = (int)(unsigned long)lv_event_get_user_data(e);
+    const uint32_t to = currentNode;
+    lv_obj_t *row = currentPanel;
+    if (!to || !row || to == THIS->ownNode)
+        return;
+    switch (action) {
+    case nodeActTrace:
+        ui_event_trace_route(NULL); // its page, with this node chosen; nothing is sent before Start
+        return;
+    case nodeActStats:
+        THIS->ui_set_active(objects.settings_button, objects.tools_statistics_panel, objects.top_statistics_panel);
+        THIS->updateHomeExtras();
+        return;
+    case nodeActQr:
+        THIS->showContactQr(to);
+        return;
+    default:
+        break;
+    }
+
+    meshtastic_Data_payload_t payload{};
+    meshtastic_PortNum port;
+    const char *what;
+    switch (action) {
+    case nodeActInfo: {
+        // our own node info, wanting theirs back: names, hardware, role and key are exchanged
+        meshtastic_User me = THIS->db.user;
+        if (firmwareNodeUser)
+            firmwareNodeUser(THIS->ownNode, &me);
+        port = meshtastic_PortNum_NODEINFO_APP;
+        payload.size = pb_encode_to_bytes(payload.bytes, sizeof(payload.bytes), &meshtastic_User_msg, &me);
+        what = "node info";
+        break;
+    }
+    case nodeActPosition: {
+        meshtastic_Position position{};
+        port = meshtastic_PortNum_POSITION_APP;
+        payload.size = pb_encode_to_bytes(payload.bytes, sizeof(payload.bytes), &meshtastic_Position_msg, &position);
+        what = "position";
+        break;
+    }
+    case nodeActMetrics:
+    case nodeActSensors: {
+        meshtastic_Telemetry telemetry{};
+        telemetry.which_variant =
+            action == nodeActMetrics ? meshtastic_Telemetry_device_metrics_tag : meshtastic_Telemetry_environment_metrics_tag;
+        port = meshtastic_PortNum_TELEMETRY_APP;
+        payload.size = pb_encode_to_bytes(payload.bytes, sizeof(payload.bytes), &meshtastic_Telemetry_msg, &telemetry);
+        what = action == nodeActMetrics ? "metrics" : "sensor values";
+        break;
+    }
+    default:
+        return;
+    }
+    const uint8_t ch = (uint8_t)(unsigned long)row->user_data;
+    int8_t hopsAway = (signed long)row->LV_OBJ_IDX(node_sig_idx)->user_data;
+    if (hopsAway < 0)
+        hopsAway = THIS->db.config.lora.hop_limit;
+    const uint8_t hopLimit = (hopsAway < THIS->db.config.lora.hop_limit ? hopsAway + 1 : hopsAway);
+    int sent = 0;
+    if (action == nodeActPosition) {
+        // A node answers a position request at the precision of the channel the request came on, and many share their
+        // position only on a private channel (a public-key channel is capped at about 700 m). So ask on each of ours
+        // with its own key first (not the MeshCore one, which goes out over MeshCore), then on the node's own channel.
+        for (int i = 1; i < 8; i++) {
+            const meshtastic_Channel &c = THIS->db.channel[i];
+            if (i != ch && c.role == meshtastic_Channel_Role_SECONDARY && c.settings.psk.size >= 16 &&
+                strcmp(c.settings.name, "MeshCore") != 0) {
+                THIS->controller->requestFromNode(to, i, hopLimit, port, payload.bytes, payload.size);
+                sent++;
+            }
+        }
+    }
+    THIS->controller->requestFromNode(to, ch, hopLimit, port, payload.bytes, payload.size);
+    askedPending = sent + 1;
+
