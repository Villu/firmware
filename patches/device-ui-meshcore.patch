+// The map's scale: a bar of a round length above the coordinates, redone when the zoom (or the latitude) changes
+static void updateMapScale(void)
+{
+    static lv_obj_t *bar = nullptr, *text = nullptr;
+    static int shownZoom = -1, shownLat = 1000;
+    if (!objects.map_location_label)
+        return;
+    const double lat = atof(lv_label_get_text(objects.map_location_label)); // the line reads "<lat> <lon>"
+    const int zoom = MapTileSettings::getZoomLevel();
+    if (lat == 0 || (zoom == shownZoom && (int)lat == shownLat))
+        return;
+    shownZoom = zoom;
+    shownLat = (int)lat;
+    if (!bar) {
+        lv_obj_t *parent = lv_obj_get_parent(objects.map_location_label);
+        bar = lv_obj_create(parent);
+        lv_obj_remove_style_all(bar);
+        lv_obj_set_style_bg_color(bar, lv_color_hex(0x000000), ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+        lv_obj_set_style_bg_opa(bar, 255, ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+        lv_obj_set_style_border_color(bar, lv_color_hex(0xffffff), ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+        lv_obj_set_style_border_width(bar, 1, ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+        lv_obj_remove_flag(bar, LV_OBJ_FLAG_CLICKABLE);
+        text = lv_label_create(parent);
+        lv_obj_set_style_text_font(text, &lv_font_montserrat_10, ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+        lv_obj_set_style_text_color(text, lv_color_hex(0xffffff), ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+        lv_obj_set_style_bg_color(text, lv_color_hex(0x000000), ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+        lv_obj_set_style_bg_opa(text, 150, ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+        lv_obj_set_style_pad_hor(text, 2, ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+        lv_obj_remove_flag(text, LV_OBJ_FLAG_CLICKABLE);
+    }
+    const double metresPerPixel = 156543.03392 * cos(lat * 3.14159265358979 / 180.0) / (double)(1UL << zoom);
+    static const uint32_t lengths[] = {10,    20,    50,    100,    200,    500,    1000,   2000,
+                                       5000,  10000, 20000, 50000,  100000, 200000, 500000, 1000000};
+    uint32_t length = lengths[0];
+    for (uint32_t candidate : lengths)
+        if (candidate / metresPerPixel <= 80)
+            length = candidate;
+    const int32_t pixels = (int32_t)(length / metresPerPixel);
+    lv_obj_set_size(bar, pixels < 4 ? 4 : pixels, 5);
+    lv_obj_align(bar, LV_ALIGN_BOTTOM_LEFT, 4, -17);
+    if (length >= 1000)
+        lv_label_set_text_fmt(text, "%u km", (unsigned)(length / 1000));
+    else
+        lv_label_set_text_fmt(text, "%u m", (unsigned)length);
+    lv_obj_align_to(text, bar, LV_ALIGN_OUT_RIGHT_MID, 4, 0);
+}
