+// The line under a chat's name in the chat list: when, who, and the start of the last message. Newest chat on top.
+static void setChatPreview(lv_obj_t *chatButton, uint32_t index, const char *when, const char *who, const char *text)
+{
+    if (!chatButton || lv_obj_get_child_count(chatButton) < 3)
+        return;
+    static lv_obj_t *const channelButtons[] = {objects.channel_button0, objects.channel_button1, objects.channel_button2,
+                                               objects.channel_button3, objects.channel_button4, objects.channel_button5,
+                                               objects.channel_button6, objects.channel_button7};
+    char line[80];
+    lv_snprintf(line, sizeof(line), "%s%s%s%s%s", when ? when : "", when && when[0] ? "  " : "", who ? who : "",
+                who && who[0] ? ": " : "", text ? text : "");
+    for (char *at = line; *at; at++)
+        if (*at == '\n' || *at == '\r')
+            *at = ' ';
+    lv_label_set_text(lv_obj_get_child(chatButton, 2), line);
+    lv_obj_move_to_index(chatButton, 0);
+
+    // a channel: the same line under its name on the Group Channels page (name, lock and bell are its first three
+    // children; the line is made when first needed, as the fourth)
+    if (index < sizeof(channelButtons) / sizeof(channelButtons[0]) && channelButtons[index]) {
+        lv_obj_t *button = channelButtons[index];
+        if (lv_obj_get_child_count(button) == 3) {
+            lv_obj_t *preview = lv_label_create(button);
+            lv_obj_set_size(preview, LV_PCT(74), 12);
+            lv_label_set_long_mode(preview, LV_LABEL_LONG_DOT);
+            lv_obj_set_align(preview, LV_ALIGN_BOTTOM_MID);
+            lv_obj_set_pos(preview, 0, 1);
+            lv_obj_set_style_text_font(preview, &lv_font_montserrat_10, ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+            lv_obj_set_style_text_color(preview, lv_color_hex(0xa0a0a0), ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+            lv_obj_set_style_text_align(preview, LV_TEXT_ALIGN_CENTER, ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+            lv_obj_set_height(button, 40); // two lines need a higher button
+            lv_obj_set_style_translate_y(lv_obj_get_child(button, 0), -8, ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT)); // the name moves up to make room
+        }
+        if (lv_obj_get_child_count(button) > 3)
+            lv_label_set_text(lv_obj_get_child(button, 3), line);
+    }
+}
