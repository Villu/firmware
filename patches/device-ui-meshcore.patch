+    // telemetry: in the opened row's one column of small lines, wrapping when long
+    for (int i : {(int)node_tm1_idx, (int)node_tm2_idx}) {
+        lv_obj_set_style_align(c[i], LV_ALIGN_TOP_LEFT, ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+        lv_obj_set_style_text_font(c[i], &lv_font_montserrat_10, ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+        lv_obj_set_style_text_align(c[i], LV_TEXT_ALIGN_LEFT, ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+        lv_obj_set_width(c[i], 245);
+        lv_label_set_long_mode(c[i], LV_LABEL_LONG_WRAP);
+        lv_obj_set_pos(c[i], -5, 78);
+    }
+}
