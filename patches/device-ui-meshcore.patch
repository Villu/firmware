+    lv_obj_set_style_text_color(meta, lv_color_hex(0xa0a0a0), ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+    lv_obj_set_align(bubble, right ? LV_ALIGN_TOP_RIGHT : LV_ALIGN_TOP_LEFT);
+    lv_obj_set_y(bubble, 12);
+    return meta;
+}
 
