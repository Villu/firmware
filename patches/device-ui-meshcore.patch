+/**
+ * What nothing else refreshes: MeshCore's counters (home cell and statistics page), and the location cell while there
+ * is no position yet.
+ */
+void TFTView_320x240::updateHomeExtras(void)
+{
+    char text[320];
+    if (meshcoreUiCounters && homeMcLabel) {
+        meshcoreUiCounters(text, sizeof(text), 0);
+        lv_label_set_text(homeMcLabel, text);
+    }
+    if (meshcoreUiCounters && statsMcLabel && activePanel == objects.tools_statistics_panel) {
+        meshcoreUiCounters(text, sizeof(text), 1);
+        lv_label_set_text(statsMcLabel, text);
+    }
+    if (firmwareGpsPosition) {
+        static int32_t shownLat = 0, shownLon = 0;
+        int32_t lat = 0, lon = 0, alt = 0;
+        if (firmwareGpsPosition(&lat, &lon, &alt) && (lat != shownLat || lon != shownLon || !hasPosition)) {
+            shownLat = lat;
+            shownLon = lon;
+            uint32_t seen = ownSats;
+            if (firmwareGpsStatus)
+                firmwareGpsStatus(&seen);
+            updatePosition(ownNode, lat, lon, alt, seen, 32); // home cell, distances to the nodes, the map's own place
+        }
+    }
+    if (!hasPosition && firmwareGpsStatus) {
+        uint32_t seen = 0;
+        const bool fix = firmwareGpsStatus(&seen);
+        if (db.config.position.gps_mode != meshtastic_Config_PositionConfig_GpsMode_ENABLED && !seen)
+            lv_snprintf(text, sizeof(text), "GPS off");
+        else
+            lv_snprintf(text, sizeof(text), "GPS: %s\n%u satellites", fix ? "fix" : "no fix", (unsigned)seen);
+        lv_label_set_text(objects.home_location_label, text);
+    }
+}
