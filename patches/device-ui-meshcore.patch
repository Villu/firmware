+// The word after the time of a message we sent
+static const char *sentStatusWord(LogMessage::MsgStatus status, bool toChannel)
+{
+    switch (status) {
+    case LogMessage::eNone:
+        return "sending";
+    case LogMessage::eHeard:
+        return "sent";
+    case LogMessage::eAcked:
+        return toChannel ? "sent" : "delivered";
+    case LogMessage::eNoResponse:
+        return "no reply";
+    case LogMessage::eFailed:
+        return "failed";
+    default:
+        return "";
+    }
+}
+
+// What became of a message we sent, on its row: the bubble's border, and the word after the time on the small line
+// ("<date time>  <status>"). The bubble remembers the status, so a repeat changes nothing; true if it changed.
+static bool applySentStatus(lv_obj_t *row, LogMessage::MsgStatus status, bool toChannel)
+{
+    if (!row || lv_obj_get_child_count(row) < 2)
+        return false;
+    lv_obj_t *bubble = lv_obj_get_child(row, 0);
+    lv_obj_t *metaLabel = lv_obj_get_child(row, 1);
+    if ((unsigned long)bubble->user_data == (unsigned long)status)
+        return false;
+    bubble->user_data = (void *)(unsigned long)status;
+    const bool failed = status == LogMessage::eFailed, acked = status == LogMessage::eAcked;
+    lv_obj_set_style_border_color(bubble, failed ? colorRed : acked ? colorBlueGreen : colorYellow,
+                                  ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+    char meta[48];
+    lv_snprintf(meta, sizeof(meta), "%s", lv_label_get_text(metaLabel));
+    char *sep = strstr(meta, "  ");
+    char *at = sep ? sep + 2 : (meta[0] >= '0' && meta[0] <= '9') ? meta + strlen(meta) : meta;
+    if (!sep && at != meta && sizeof(meta) - (at - meta) > 3) {
+        strcpy(at, "  ");
+        at += 2;
+    }
+    lv_snprintf(at, sizeof(meta) - (at - meta), "%s", sentStatusWord(status, toChannel));
+    lv_label_set_text(metaLabel, meta);
+    lv_obj_set_style_text_color(metaLabel,
+                                failed ? colorRed : acked && !toChannel ? colorMesh : lv_color_hex(0xa0a0a0),
+                                ((lv_style_selector_t)LV_PART_MAIN | (lv_style_selector_t)LV_STATE_DEFAULT));
+    return true;
+}
